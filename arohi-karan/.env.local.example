# Copy this file to .env.local and fill in the endpoint.
#
# The RSVP form posts here. Create a form at https://formspree.io and paste its
# endpoint below. Until this is set the form shows its error state rather than
# faking a successful submission.
#
# NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# Optional. Used for absolute Open Graph URLs in the link preview card.
# NEXT_PUBLIC_SITE_URL=https://arohi-and-karan.example
